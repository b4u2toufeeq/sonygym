# ==========================================================================
#  Sony Care (Sony Enterprises) — Apache / cPanel configuration
#  Canonical host: https://sonycare.in
#
#  Order matters here. Canonical redirect runs FIRST so that every later
#  rule (caching, MIME types, headers) only ever sees a single host and
#  a single scheme.
# ==========================================================================

# --------------------------------------------------------------------------
# 1. Canonical host + scheme  (P0 — Lighthouse "HTTPS score 0")
#
#    http://sonycare.in        -> https://sonycare.in
#    http://www.sonycare.in    -> https://sonycare.in
#    https://www.sonycare.in   -> https://sonycare.in
#
#    A 301 is used (not 302) so search engines treat it as permanent.
#    %{HTTPS} !=on also catches Cloudflare/cPanel "offloaded SSL", where
#    the request arrives on port 80 even though the visitor used TLS.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- www -> non-www, over both schemes -------------------------------
  RewriteCond %{HTTP_HOST} ^www\.sonycare\.in$ [NC]
  RewriteRule ^ https://sonycare.in%{REQUEST_URI} [L,R=301]

  # --- force TLS on the bare domain ------------------------------------
  # Skip the redirect entirely for robots.txt/sitemap.xml/favicon.ico so
  # crawlers and browser bookmarklets always get a 200.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{REQUEST_URI} !^/(robots\.txt|sitemap\.xml|crossdomain\.xml)$ [NC]
  RewriteCond %{HTTP_HOST} !^localhost$ [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
  RewriteRule ^ https://sonycare.in%{REQUEST_URI} [L,R=301]
</IfModule>

# --------------------------------------------------------------------------
# 2. Modern image formats
#
#    Some cPanel hosts still lack the AddType entries for WebP/AVIF. If they
#    are missing the server sends application/octet-stream and Safari will
#    refuse to render the <source>. These lines make the types explicit.
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif                      .avif
  AddType image/webp                      .webp
  AddType image/svg+xml                   .svg
  AddType image/x-icon                    .ico
  AddType font/woff2                      .woff2
  AddCharset utf-8                        .css .js .json .webmanifest .xml
</IfModule>

# --------------------------------------------------------------------------
# 3. Brotli + gzip  (matters a lot: CSS and AVIF are what is left after
#    the image work, and AVIF is already compressed — it must not be
#    gzipped a second time.)
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json application/xml \
    application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json application/xml \
    application/manifest+json image/svg+xml
  # Never re-compress images or fonts — they are already compressed.
  SetEnvIfNoCase Request_URI \.(?:avif|webp|png|jpe?g|gif|ico|woff2?|ttf|eot|zip|pdf)$ no-gzip dont-vary
</IfModule>

# --------------------------------------------------------------------------
# 4. Browser caching
#
#    Two tiers:
#      - fingerprinted/never-changing assets -> 1 year, immutable
#      - everything else (HTML)               -> short, must revalidate
#
#    The ?v= query string is deliberately NOT part of the FilesMatch below:
#    query strings do not reach the filesystem, so the year-long rule is
#    safe for these. If you rename assets on update (see note at the end of
#    this file), that is the correct time to bust the cache.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 week"

  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/xml                "access plus 1 day"
  ExpiresByType application/xml         "access plus 1 day"
  ExpiresByType application/json        "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"

  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"

  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived cache for the static asset tree.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico|css|js|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always be revalidated, otherwise a deploy is invisible to
  # returning visitors who keep the old document.
  <FilesMatch "\.(html?|php)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # An <img> with a ?v=2 cache-buster must not be served from a stale copy.
  <FilesMatch "\.(avif|webp|png|jpe?g|gif|svg|ico|css|js)$">
    Header set Vary "Accept-Encoding"
  </FilesMatch>

  # AVIF and WebP are content-negotiated on Accept — pin that in the cache.
  <FilesMatch "\.(avif|webp)$">
    Header append Vary "Accept"
  </FilesMatch>

  # --- security headers -------------------------------------------------
  # 'unsafe-inline' for style-src is required: Bootstrap and the modal
  # carousel set inline styles at runtime.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  <FilesMatch "\.(css|js|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 5. Pretty URLs
#
#    /gym/about.html  ->  /gym/about
#
#    The directory guard is required: without it, /gym/ would match the
#    trailing-slash rule and be redirected to /gym, which has no index of
#    its own and would 404.
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  # strip the trailing slash, but never off a real directory
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # strip .html / .htm from the visible URL
  RewriteCond %{REQUEST_URI} ^/(.+)\.html?$ [NC]
  RewriteRule ^ /%1 [L,R=301]

  # and quietly resolve it back to the file on disk (no redirect, no loop)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^ %{REQUEST_URI}.html [END]
</IfModule>

# --------------------------------------------------------------------------
# 6. PHP — cPanel EA handler
# --------------------------------------------------------------------------
# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# --------------------------------------------------------------------------
# 7. Housekeeping
# --------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  # -MultiViews on purpose: section 5 already resolves extensionless URLs
  # explicitly, and leaving MultiViews on makes both rules compete.
  Options -Indexes -MultiViews
</IfModule>

# Block deploy leftovers that must never be public.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(zip|md|log|ini|sh|bak|sql)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(abcde|sony-responsive-images|sonyresponsiveimages)\.html?$">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteRule ^(sony-responsive-images|sony-responsive-images\.zip|sonycare\.zip|spec)(/|$) - [F,L]
</IfModule>

# NOTE: do NOT blanket-deny dotfiles here. /.well-known/acme-challenge/ must
# stay reachable or automatic SSL renewal will fail once the cert expires.

# ==========================================================================
#  Cache busting
#  The 1-year immutable rules above mean a changed file with the same name
#  will NOT be picked up. Bump the version string in index.html when you
#  replace an asset, e.g.
#      assets/css/site.min.css?v=2.1
#  Alternatively, serve assets as
#      assets/css/site.2.1.min.css
#  and add a RewriteRule to strip the .<version> segment.
# ==========================================================================
